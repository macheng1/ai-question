
# 数据库主机地址；本机启动填写可连接的主机，容器部署填写数据库服务地址。
DB_HOST=127.0.0.1
# MySQL 端口。
DB_PORT=3306
# 业务数据库名称。
DB_NAME=aiquestion
# 应用连接数据库的用户名。
DB_USERNAME=dengke
# 应用数据库密码；保密，不提交到 Git。
DB_PASSWORD=dengke_password
# Docker 初始化 MySQL 时使用的 root 密码，不是应用连接密码。
DB_ROOT_PASSWORD=root_password
# Redis 主机地址。
REDIS_HOST=127.0.0.1
# Redis 端口。
REDIS_PORT=6379
# Redis 键前缀，用于隔离不同环境的数据。
REDIS_KEY_PREFIX=aiquestion:
# Redis 密码；服务未设置认证时留空。
REDIS_PASSWORD=
# Redis 逻辑数据库编号。
REDIS_DATABASE=0
# 后端进程监听端口；Docker Compose 内部监听端口以 compose 配置为准。
SERVER_PORT=18080
# Docker 映射到宿主机的后端端口。
API_PORT=18080
# Docker 映射到宿主机的前端端口。
FRONTEND_PORT=13000
# 浏览器访问的 API 根地址，包含 /api；前端构建时写入，修改后需重新构建前端。
NEXT_PUBLIC_API_BASE_URL=http://localhost:18080/api
# 登录令牌签名密钥；使用足够长的随机值，保密。
JWT_SECRET=replace-with-a-random-secret-at-least-32-chars
# 登录令牌有效期，例如 7d。
JWT_EXPIRES_IN=7d
# 刷新令牌签名密钥；与登录令牌密钥分开设置，保密。
JWT_REFRESH_SECRET=replace-with-another-random-secret-at-least-32-chars
# 刷新令牌有效期，例如 30d。
JWT_REFRESH_EXPIRES_IN=30d
# 阿里云短信 AccessKey ID。
ALIYUN_SMS_ACCESS_KEY_ID=
# 阿里云短信 AccessKey Secret，保密。
ALIYUN_SMS_ACCESS_KEY_SECRET=
# 阿里云短信服务地址。
ALIYUN_SMS_ENDPOINT=https://dysmsapi.aliyuncs.com
# 已审核通过的阿里云短信签名。
ALIYUN_SMS_SIGN_NAME=
# 已审核通过的阿里云短信模板编号。
ALIYUN_SMS_TEMPLATE_CODE=
# 阿里云 OSS AccessKey ID；使用阿里云或读取历史阿里云文件时需要。
ALIYUN_OSS_ACCESS_KEY_ID=
# 阿里云 OSS AccessKey Secret，保密。
ALIYUN_OSS_ACCESS_KEY_SECRET=
# 阿里云 OSS 服务地址，应与桶所在区域一致。
ALIYUN_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# 阿里云 OSS 桶名称。
ALIYUN_OSS_BUCKET=
# 阿里云 OSS 区域标识，与 EDS 签名区域参数无关。
ALIYUN_OSS_REGION=oss-cn-hangzhou
# 普通附件默认单文件大小限制，单位 MB。
UPLOAD_DEFAULT_MAX_SIZE_MB=10
# 普通附件允许配置的单文件大小上限，单位 MB。
UPLOAD_ABSOLUTE_MAX_SIZE_MB=100
# 普通附件单次上传的默认文件数量限制。
UPLOAD_DEFAULT_MAX_COUNT=1
# 普通附件允许配置的单次上传数量上限。
UPLOAD_ABSOLUTE_MAX_COUNT=20

# 手动培训邮件提醒（未配置时禁止发送）
# SMTP 邮件服务器地址。
MAIL_HOST=
# SMTP 端口，与邮件服务的 TLS/SSL 配置一致。
MAIL_PORT=587
# SMTP 登录账号。
MAIL_USERNAME=
# SMTP 密码或授权码，保密。
MAIL_PASSWORD=
# 发件人邮箱地址。
MAIL_FROM=
# 是否启用 SMTP 身份认证。
MAIL_SMTP_AUTH=true
# 是否启用 STARTTLS。
MAIL_STARTTLS=true
# 是否启用直接 SSL 连接。
MAIL_SSL=false
# 用户可访问的前端网站根地址，用于生成业务链接。
APP_PUBLIC_URL=

# 新文件存储类型：不配置时默认 eds；测试环境使用阿里云时显式填写 aliyun。
STORAGE_PROVIDER=eds
# EDS S3 服务地址，包含协议和端口；后端须可连通，HTTPS 仅 EDS 客户端跳过证书和主机名验证。
EDS_ENDPOINT=
# EDS 桶名称，由存储服务提供方分配。
EDS_BUCKET=
# EDS AccessKey ID，由存储服务提供方分配。
EDS_ACCESS_KEY_ID=
# EDS SecretKey，保密；仅写本地或部署环境，不提交 Git。
EDS_SECRET_KEY=
# S3 SDK 签名区域：默认留空，与厂商普通上传示例一致；如供应方指定区域，则填写实际值。
EDS_REGION=

# 对外 API 根地址（包含 /api），用于普通附件链接；留空使用当前请求地址
# 普通附件使用的对外 API 根地址，包含 /api 且不以斜杠结尾；留空从请求推导。
STORAGE_PUBLIC_BASE_URL=
