<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aiquestion.repository.TrainingAccessRepository">
  <select id="countActiveAdministrator" resultType="java.lang.Integer">
